@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="alert alert-dark">
                <h2>Panel de Administración</h2>
                <p class="lead">Gestión de actividades y usuarios</p>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h4>?? Gestión de Usuarios</h4>
                </div>
                <div class="card-body">
                    <p>Administración de cuentas y permisos</p>
                    <ul>
                        <li>Crear y modificar usuarios</li>
                        <li>Asignar roles y permisos</li>
                        <li>Monitoreo de actividad</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <button class="btn btn-primary">Gestionar Usuarios</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h4>?? Estadísticas</h4>
                </div>
                <div class="card-body">
                    <p>Informes y métricas del sistema</p>
                    <ul>
                        <li>Actividad de usuarios</li>
                        <li>Uso de recursos</li>
                        <li>Rendimiento del sistema</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <button class="btn btn-secondary">Ver Estadísticas</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h4>?? Configuración</h4>
                </div>
                <div class="card-body">
                    <p>Personalización del sistema</p>
                    <ul>
                        <li>Opciones generales</li>
                        <li>Personalización de interfaz</li>
                        <li>Seguridad y respaldos</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <button class="btn btn-info">Configurar Sistema</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h4>?? Gestión de Contenido</h4>
                </div>
                <div class="card-body">
                    <p>Administrar contenido de actividades</p>
                    <ul>
                        <li>Crear nuevas actividades</li>
                        <li>Editar contenido existente</li>
                        <li>Categorizar actividades</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <button class="btn btn-success">Gestionar Contenido</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver a Actividades</a>
    </div>
</div>