@{
    ViewData["Title"] = "Actividades Femeninas";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="alert alert-danger">
                <h2>Actividades Femeninas</h2>
                <p class="lead">Actividades específicas para usuarias femeninas</p>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-danger text-white">
                    <h4>🧘‍♀️ Yoga y Pilates</h4>
                </div>
                <div class="card-body">
                    <p>Técnicas de relajación y fortalecimiento</p>
                    <ul>
                        <li>Sesiones para todos los niveles</li>
                        <li>Yoga restaurativo</li>
                        <li>Ejercicios de flexibilidad</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h4>🎨 Artesanía creativa</h4>
                </div>
                <div class="card-body">
                    <p>Proyectos de manualidades y diseño</p>
                    <ul>
                        <li>Técnicas de pintura</li>
                        <li>Diseño textil</li>
                        <li>Decoración de interiores</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver a Actividades</a>
    </div>
</div>