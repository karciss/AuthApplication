@{
    ViewData["Title"] = "Actividades Masculinas";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="alert alert-primary">
                <h2>Actividades Masculinas</h2>
                <p class="lead">Actividades específicas para usuarios masculinos</p>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4>🏋️‍♂️ Entrenamiento de fuerza</h4>
                </div>
                <div class="card-body">
                    <p>Rutinas de entrenamiento para desarrollar resistencia física</p>
                    <ul>
                        <li>Programa de 12 semanas</li>
                        <li>Ejercicios de alta intensidad</li>
                        <li>Nutrición específica</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h4>🏀 Deportes de equipo</h4>
                </div>
                <div class="card-body">
                    <p>Estrategias para deportes colectivos</p>
                    <ul>
                        <li>Tácticas de fútbol</li>
                        <li>Básquetbol avanzado</li>
                        <li>Desarrollo de liderazgo</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver a Actividades</a>
    </div>
</div>