@{
    ViewData["Title"] = "Actividades Deportivas";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Actividades</a></li>
            <li class="breadcrumb-item active">Deportes</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-12">
            <h1>⚽ Actividades Deportivas</h1>
            <p class="lead">Descubre actividades deportivas y mantente activo</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Rutinas de Ejercicio</h4>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">🏃 Rutina de Cardio</h5>
                                <small class="text-primary">Nivel: Principiante</small>
                            </div>
                            <p class="mb-1">Rutina de 15 minutos para mejorar la resistencia cardiovascular</p>
                            <button class="btn btn-sm btn-primary">Ver rutina</button>
                        </div>

                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">⚽ Entrenamiento de Fútbol</h5>
                                <small class="text-warning">Nivel: Intermedio</small>
                            </div>
                            <p class="mb-1">Ejercicios para mejorar el control del balón</p>
                            <button class="btn btn-sm btn-primary">Ver ejercicios</button>
                        </div>

                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">🏀 Básquetbol para principiantes</h5>
                                <small class="text-info">Nivel: Principiante</small>
                            </div>
                            <p class="mb-1">Aprende los fundamentos del baloncesto</p>
                            <button class="btn btn-sm btn-primary">Ver tutorial</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5>📆 Próximos Eventos</h5>
                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Torneo de Fútbol
                            <span class="badge bg-primary rounded-pill">3 días</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Maratón Escolar
                            <span class="badge bg-primary rounded-pill">2 semanas</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Clase de Natación
                            <span class="badge bg-primary rounded-pill">1 mes</span>
                        </li>
                    </ul>
                    <hr>
                    <h5>💪 Consejos de Entrenamiento</h5>
                    <p>Recuerda hidratarte bien antes, durante y después de realizar actividad física.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">← Volver a Actividades</a>
    </div>
</div>